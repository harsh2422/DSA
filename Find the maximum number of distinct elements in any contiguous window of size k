// Online Java Compiler
// Find the maximum number of distinct elements in any contiguous window of size k.
import java.util.*;
class Main {
    public static void main(String[] args) {
        System.out.println("Start small. Ship something.");
       int[] nums = {1, 2, 1, 3, 4, 2, 3};
       int k = 4;
        
       HashMap<Integer,Integer> map = new HashMap<Integer,Integer>();
       for(int i=0;i<k;i++){
          if(!map.containsKey(nums[i])){
               map.put(nums[i],1);
               
          }
          else{
            int currFreq = map.get(nums[i]);
            currFreq++;
            map.put(nums[i],currFreq);
          }
       }
        int maxDistinct = map.size();

       for(int i=k;i<nums.length;i++){
       int outgoing = nums[i-k];
       if(map.containsKey(outgoing)){
       int currFreq = map.get(outgoing);
       currFreq--;
       if(currFreq==0){
            map.remove(outgoing);
            }
         else{
             map.put(outgoing,currFreq);
         }
        }

        int incoming = nums[i];
        if(!map.containsKey(incoming)){
             map.put(incoming,1);
        }
        else{
            int currFreq = map.get(incoming);
                currFreq++;
                map.put(incoming,currFreq);
            }

            if(map.size()>maxDistinct){
                maxDistinct = map.size();
            }
        
        

       }
       System.out.println("maxDistint "+ maxDistinct);
      
        
    }
}
