/*
Pattern: Binary Search - First Occurrence

Recognition:
Sorted array with duplicates.
Need the FIRST index of target.

Anchor:
FOUND does NOT mean STOP.

When target is found:
save mid
continue LEFT

ans = mid
right = mid - 1

First -> LEFT

Time: O(log n)
Space: O(1)
*/

import java.util.*;
class Main {
    public static void main(String[] args) {
        System.out.println("Start small. Ship something.");
        int ans =-1;
        int[] nums = {2, 4, 4, 4, 7, 9};
        int target = 4;
        int left =0;
        int right=nums.length-1;
        while(left<=right){
            int mid = (left+right)/2;
            if(target>nums[mid]){
              left = mid+1;
            }
            else if(target<nums[mid]){
                right = mid-1;
            }
            else{
                ans= mid;
                right= mid-1;
            }
        }
       
        System.out.println(ans);
      
    }
}
