/*
Pattern: Frequency Map

Recognition:
Need to know how many times each number occurs.

Anchor:
number -> frequency

Approach:
1. Build frequency map.
2. Traverse original array again.
3. First number with frequency 1 is the answer.

Why second traversal?
HashMap order does not represent original array order.

Time: O(n)
Space: O(n)
*/

import java.util.*;
class Main {
    public static void main(String[] args) {
        System.out.println("Start small. Ship something.");
        Integer result =0;
        HashMap<Integer,Integer> map = new HashMap<Integer,Integer>();
        int[] nums = {4, 5, 1, 2, 1, 4, 5};
        for(int num: nums){
              if(map.containsKey(num)){
                  int frequency = map.get(num);
                  frequency++;
                  map.put(num,frequency);
              }
              else{
                map.put(num,1);
              }
        }
       for(int num:nums){
        if(map.get(num)==1){
            result = num;
            break;
        }
       }
        System.out.println("Answer"+ result);
    }
}
