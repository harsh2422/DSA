/*
Problem: Move Zeros

Pattern: Two Pointers

Recognition:
Need to move zeros to the end in-place while preserving
the order of non-zero elements.

Anchor:
i -> scan
j -> place

Key Idea:
If nums[i] != 0:
swap nums[i] with nums[j]
j++

Time: O(n)
Space: O(1)
*/

import java.util.*;

class Main {
    public static void main(String[] args) {

        int[] nums = {0, 3, 0, 8, 1, 0, 6};

        int j = 0;

        for(int i = 0; i < nums.length; i++) {

            if(nums[i] != 0) {

                int temp = nums[i];
                nums[i] = nums[j];
                nums[j] = temp;

                j++;
            }
        }

        System.out.println(Arrays.toString(nums));
    }
}
