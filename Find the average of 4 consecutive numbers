/*
Pattern: Fixed Sliding Window

Recognition:
Need maximum average of a fixed-size window.

Anchor:
Maximum average for equal-size windows
= window having maximum sum.

i enters
i-k leaves

Approach:
Find maximum window sum first.
Divide by k only at the end.

Time: O(n)
Space: O(1)
*/

class Main {
    public static void main(String[] args) {
        System.out.println("Start small. Ship something.");
        int nums[] ={1, 12, -5, -6, 50, 3};
        int k = 4;
        int windowSum=0;
        float maxSum =0;
        double maxAverage=0;
        for(int i=0;i<k;i++){
            windowSum = windowSum+ nums[i];
            
        }
        maxSum = windowSum;
        for(int i=k;i<nums.length;i++){
            windowSum = windowSum -nums[i-k]+ nums[i];
            if(windowSum>maxSum){
                maxSum = windowSum;
                
            }
        }
         System.out.println(maxSum);
            maxAverage = (double)maxSum/k;
        System.out.println(maxAverage);
    }
}
